<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <div class="row col-8 offset-2 mt-3">
                    <h2><b><%= listing.title %></b></h2>
                </div>
                <div class="card col-6 offset-2 listing-card">
                    <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing_image">
                    <div class="card-body">
                        <p class="card-text">
                            <p>Owned By: <u><i><%= listing.owner.username %></i></u></p>
                            <p><%= listing.description %></p>
                            <p><%= listing.price.toLocaleString("en-IN") %></p>
                            <p><%= listing.location %></p>
                            <p><%= listing.country %></p>
                        </p>
                    </div>
                </div>
                <% if(userLogin && userLogin._id.equals(listing.owner._id)) { %>
                <div class="btns offset-2">
                    <form method="get" action="/listings/<%= listing._id %>/edit">
                        <button class="btn btn-dark ad-btn">Edit</button>
                    </form>
                    <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-dark offset-10">Delete</button>
                    </form>
                </div>
                <% } %>
            </div>
            <div class="col-8 offset-3 mb-3">
                <% if(userLogin) { %>
                <h4>leave a Review</h4>
                <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation" novalidate>
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-level">Rating</label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div>
                    <div class="mt-3 mb-3">
                        <label for="comment" class="form-level">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control" required></textarea>
                        <div class="invalid-feedback">Please add review</div>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
                <% } %>
                <hr>
                <p><b>All Review</b></p>
                <div class="row">
                <% for(review of listing.reviews) { %>
                <div class="card col-5 ms-2 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@ <i><%= review.author.username %></h5></i>
                        <p class="card-text"><%= review.comment %></p>
                        <p class="card-text"><%= review.rating %> Stars</p>
                        <% if(userLogin && userLogin._id.equals(review.author._id)) { %>
                        <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn mb-3 btn-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% } %>
                </div>
            </div>
        </div>
    </body>