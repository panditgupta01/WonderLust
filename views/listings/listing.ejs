<% layout("/layouts/boilerplate") %>

<script>
    const listing = <%- JSON.stringify(listing) %>;
</script>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <div class="row col-8 offset-2 mt-3">
                    <h2><b>
                            <%= listing.title %>
                        </b></h2>
                </div>
                <div class="card col-6 offset-2 listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Listing_image">
                    <div class="card-body">
                        <p class="card-text">
                        <p>Owned By: <u><i>
                                    <%= listing.owner.username %>
                                </i></u></p>
                        <p style="font-size: 90%;">
                            <%= listing.description %>
                        </p>
                        <p>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %>
                        </p>
                        <p>
                            <%= listing.location %>
                        </p>
                        <p>
                            <%= listing.country %>
                        </p>
                        </p>
                    </div>
                </div>
                <% if(userLogin && userLogin._id.equals(listing.owner._id)) { %>
                    <div class="btns offset-2">
                        <form method="get" action="/listings/<%= listing._id %>/edit">
                            <button class="btn btn-dark ad-btn">Edit</button>
                        </form>
                        <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-dark offset-10">Delete</button>
                        </form>
                    </div>
                    <% } %>
            </div>
            <div class="col-8 offset-3 mb-3">
                <% if(userLogin) { %>
                    <h4>leave a Review</h4>
                    <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation"
                        novalidate>
                        <div class="mb-3 mt-3">
                            <label for="rating" class="form-level">Rating</label>
                            <fieldset class="starability-basic">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mt-3 mb-3">
                            <label for="comment" class="form-level">Comment</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"
                                required></textarea>
                            <div class="invalid-feedback">Please add review</div>
                        </div>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <% } %>
                        <hr>
                        <% if(listing.reviews.length > 0) { %>
                        <p><b>All Review</b></p>
                        <div class="row">
                            <% for(review of listing.reviews) { %>
                                <div class="card col-5 ms-2 mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title">@ <i>
                                                <%= review.author.username %>
                                        </h5></i>
                                        <p class="starability-result" data-rating="<%= review.rating %>">
                                        </p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>
                                        <!-- <p class="card-text"><%= review.rating %> Stars</p> -->
                                        <% if(userLogin && userLogin._id.equals(review.author._id)) { %>
                                            <form method="post"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <button class="btn mb-3 btn-dark">Delete</button>
                                            </form>
                                            <% } %>
                                    </div>
                                </div>
                                <% } %>
                        </div>
                        <% } %>
                        <% if(listing.geometry.coordinates.length> 0) { %>
                            <div class="mb-3 mt-3">
                                <h3>Where you'll be</h3>
                                <div id="map"></div>
                                <% } %>
                            </div>
                                
        </div>
    </div>
</div>
<script src="/js/map.js"></script>
</body>
